# Dispatches local environment template
# Copy to .env locally and fill values outside Git. Do not commit real credentials.

# SMTP/email notification settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-with-rotated-app-password
SMTP_FROM=alerts@example.com
EMAIL_TO=operator@example.com
SMTP_USE_SSL=0
SMTP_USE_TLS=1
SMTP_RELAX_X509_STRICT=0
EMAIL_ON_SUCCESS=0
EMAIL_ON_FAILURE=1

# Optional TLS/diagnostic settings; leave unset unless needed.
# SMTP_TLS_VERIFY=1
# SMTP_TRUSTSTORE=0
# SMTP_TLS_CA_SOURCE=auto
# SMTP_CA_FILE=
# SMTP_CA_BUNDLE=
# SMTP_TIMEOUT=30
# SMTP_RETRIES=2
# SMTP_RETRY_DELAY=1
