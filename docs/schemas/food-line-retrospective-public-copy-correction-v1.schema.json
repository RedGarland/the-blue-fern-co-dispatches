{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.thebluefernco.com/schemas/food-line-retrospective-public-copy-correction-v1.schema.json",
  "title": "Food Line retrospective public-copy correction",
  "type": "object",
  "required": ["schema_version", "correction_type", "correction_identity", "decision_commit", "decision_path", "decision_blob_sha1", "decision_sha256", "event_id", "field", "prior_text", "prior_utf8_hex", "prior_sha256", "replacement_text", "replacement_utf8_hex", "replacement_sha256", "corrected_public_copy_sha256", "reason", "corrected_by", "corrected_at", "original_decision_immutable", "approval_authorized", "generation_authorized", "publication_authorized", "pages_authorized"],
  "properties": {
    "schema_version": {"const": "food_line_retrospective_public_copy_correction_v1"},
    "correction_type": {"const": "encoding_mojibake_public_copy_overlay"},
    "correction_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision_path": {"type": "string", "minLength": 1},
    "decision_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_id": {"type": "string", "pattern": "^food-line-event-[0-9a-f]{24}$"},
    "field": {"const": "publication_copy.summary"},
    "prior_text": {"type": "string", "minLength": 1},
    "prior_utf8_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
    "prior_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replacement_text": {"type": "string", "minLength": 1},
    "replacement_utf8_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
    "replacement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corrected_public_copy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1},
    "corrected_by": {"type": "string", "minLength": 1},
    "corrected_at": {"type": "string", "format": "date-time"},
    "original_decision_immutable": {"const": true},
    "approval_authorized": {"const": false},
    "generation_authorized": {"const": false},
    "publication_authorized": {"const": false},
    "pages_authorized": {"const": false}
  },
  "additionalProperties": false
}
