      "allowed_domains": ["centraltexasfoodbank.org"],
      "geographic_scope": "state_local",
      "state_or_territory": "Texas",
      "enabled": true,
      "sampling_priority": 30,
      "direct_source_candidate_cap": 1,
      "historical_capable": true,
      "max_age_days": 14,
      "pressure_terms": ["food bank", "food pantry", "demand", "summer meals", "distribution", "SNAP"],
      "exclusion_terms": ["volunteer", "gala", "recipe"],
