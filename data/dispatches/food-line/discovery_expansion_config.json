{
  "search": {
    "provider": "google_news_rss",
    "rss_url_template": "https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en",
    "exclude_domains": [
      "facebook.com",
      "x.com",
      "twitter.com",
      "instagram.com",
      "youtube.com"
    ]
  },
  "direct_sources": [
    {
      "source_name": "NPR National Desk",
      "source_family": "public_radio",
      "discovery_lane": "public_radio",
      "discovery_channel": "direct_rss",
      "feed_url": "https://feeds.npr.org/1001/rss.xml",
      "source_url": "https://www.npr.org/sections/national/",
      "allowed_domains": ["npr.org"],
      "geographic_scope": "national",
      "enabled": true,
      "sampling_priority": 10,
      "direct_source_candidate_cap": 1,
      "max_age_days": 7,
      "pressure_terms": ["food bank", "food pantry", "food insecurity", "summer meals", "SNAP", "EBT"],
      "exclusion_terms": ["recipe", "restaurant", "opinion"],
      "notes": "Direct NPR feed for article URLs without Google News wrappers."
    },
    {
      "source_name": "Feeding America Blog",
      "source_family": "nonprofit_report",
      "discovery_lane": "nonprofit_report",
      "discovery_channel": "direct_page",
      "source_url": "https://www.feedingamerica.org/hunger-blog",
      "allowed_domains": ["feedingamerica.org"],
      "geographic_scope": "national",
      "enabled": true,
      "sampling_priority": 20,
      "direct_source_candidate_cap": 1,
      "historical_capable": true,
      "max_age_days": 14,
      "pressure_terms": ["food insecurity", "meal gap", "child hunger", "food bank", "SNAP"],
      "exclusion_terms": ["fundraiser", "donation form", "about us"],
      "notes": "National nonprofit reporting with archive listings that expose article dates for older backfill windows."
    },
    {
      "source_name": "Central Texas Food Bank News",
