{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluefern.example/schemas/source-based-retrospective-publication-request-v1.schema.json",
  "title": "Source-based retrospective publication authorization request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch",
    "publication_batch_id",
    "authorized_by",
    "authorized_at",
    "source_base_commit",
    "expected_item_count",
    "release_bindings",
    "publication_items"
  ],
  "properties": {
    "schema_version": {"const": "bluefern.source_based_retrospective_publication_request.v1"},
    "dispatch": {"enum": ["food-line", "care-line"]},
    "publication_batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,120}$"},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "minLength": 1},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_item_count": {"type": "integer", "minimum": 1},
    "release_bindings": {"type": "array", "minItems": 1},
    "publication_items": {"type": "array", "minItems": 1}
  }
}
