{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.bluefern.company/schemas/gaza-historical-catchup-publication-state-v1.schema.json",
  "title": "Gaza historical catch-up publication state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "catchup_id", "publication_date", "published_at", "approval_commit",
    "approval_path", "approval_sha256", "source_head", "pages_pre_publish_head",
    "pages_publish_commit", "candidate_ids", "event_fingerprints", "dedupe_recorded", "published"
  ],
  "properties": {
    "schema_version": {"const": "gaza_historical_catchup_publication_state_v1"},
    "catchup_id": {"type": "string"},
    "publication_date": {"type": "string", "format": "date"},
    "published_at": {"type": "string", "format": "date-time"},
    "approval_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval_path": {"type": "string", "pattern": "^approvals/gaza/.+\\.json$"},
    "approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pages_pre_publish_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pages_publish_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_ids": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
    "event_fingerprints": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
    "dedupe_recorded": {"const": true},
    "published": {"const": true}
  }
}
