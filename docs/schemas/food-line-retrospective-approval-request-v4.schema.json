{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.thebluefernco.com/schemas/food-line-retrospective-approval-request-v4.schema.json",
  "title": "Private renewed Food Line retrospective approval request",
  "type": "object",
  "required": ["schema_version", "batch_id", "edition_date", "edition_title", "edition_introduction", "retrospective_disclosure", "approved_by", "approved_at", "source_base_commit", "pages_head", "decision_bindings", "correction_bindings", "audio_authorized", "publication_authorized"],
  "properties": {
    "schema_version": {"const": "food_line_retrospective_approval_request_v4"},
    "batch_id": {"type": "string", "pattern": "^food-line-[a-z0-9-]+-retrospective-[0-9]{2}$"},
    "edition_date": {"type": "string", "format": "date"},
    "edition_title": {"type": "string", "minLength": 1},
    "edition_introduction": {"type": "string", "minLength": 1},
    "retrospective_disclosure": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pages_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision_bindings": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/git_binding"}},
    "correction_bindings": {"type": "array", "items": {"$ref": "#/$defs/git_binding"}},
    "audio_authorized": {"const": false},
    "publication_authorized": {"const": true}
  },
  "$defs": {
    "git_binding": {
      "type": "object",
      "required": ["commit", "path", "blob_sha1", "sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
