    {
      "query_family": "social_watchlist",
      "geographic_scope": "national",
      "source_family": "local_news",
      "templates": [
        "\"food bank demand\" site:x.com OR site:facebook.com OR site:instagram.com",
        "\"food pantry shortage\" site:x.com OR site:facebook.com OR site:instagram.com",
        "\"summer hunger\" site:x.com OR site:facebook.com OR site:instagram.com"
      ]
    },
    {
      "query_family": "pressure",
      "geographic_scope": "national",
      "source_family": "local_news",
      "templates": [
        "(\"food bank\" OR \"food pantry\") (demand OR strain OR shortage OR surge)",
        "(\"food bank\" OR \"food pantry\") (\"increased need\" OR waitlist OR \"funding gap\")",
        "\"food bank shelves\"",
        "\"food bank inventory\"",
        "\"food bank donations down\"",
        "\"food bank serving more families\"",
        "\"mobile pantry demand\""
      ]
    },
    {
      "query_family": "policy_program",
      "geographic_scope": "national",
      "source_family": "state_policy_news",
      "templates": [
        "(SNAP OR EBT) (cuts OR changes OR benefits OR families)",
        "(\"summer meals\" OR \"school meals\") (families OR children OR hunger)",
        "(WIC OR TEFAP OR \"Meals on Wheels\") (cuts OR delays OR waitlist)",
        "\"food stamps\" \"food bank demand\"",
        "\"EBT delay\" \"food pantry\"",
        "\"Meals on Wheels\" waitlist",
        "\"senior meal waitlist\""
      ]
    },
    {
      "query_family": "cost_pressure",
      "geographic_scope": "national",
      "source_family": "local_news",
      "templates": [
        "(\"grocery prices\" OR \"food costs\") (\"food pantry\" OR families)",
