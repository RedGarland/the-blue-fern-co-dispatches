{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gaza-edition-correction-publication-authorization-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publication_type", "correction_id", "authorized_by", "authorized_at", "source_approval_commit", "approval_commit", "approval_path", "approval_fingerprint", "proposal_sha256", "pages_head", "package_manifest_sha256", "package_artifact_set_sha256", "rendered_audio_sha256", "publication_authorized", "pages_authorized", "social_authorized", "source_changes_authorized", "audio_authorized", "publication_executed", "artifact_count", "affected_files", "authorization_fingerprint"],
  "properties": {
    "schema_version": {"const": "gaza_edition_correction_publication_authorization_v1"},
    "publication_type": {"const": "gaza_edition_correction_publication_authorization"},
    "correction_id": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "format": "date-time"},
    "source_approval_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval_path": {"type": "string", "minLength": 1},
    "approval_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proposal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pages_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "package_artifact_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rendered_audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_authorized": {"const": true}, "pages_authorized": {"const": true},
    "social_authorized": {"const": false}, "source_changes_authorized": {"const": false},
    "audio_authorized": {"const": false}, "publication_executed": {"const": false},
    "artifact_count": {"type": "integer", "minimum": 1},
    "affected_files": {"type": "array", "minItems": 1},
    "authorization_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
