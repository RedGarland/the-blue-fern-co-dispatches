{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.thebluefernco.com/schemas/food-line-retrospective-approval-v4.schema.json",
  "title": "Committed renewed Food Line migrated-event retrospective approval",
  "type": "object",
  "required": ["schema_version", "approval_type", "approval_fingerprint", "batch_id", "edition_date", "edition_title", "edition_introduction", "retrospective_disclosure", "approved_by", "approved_at", "source_base_commit", "pages_head", "recovery_identity_sha256", "recovery_artifact_set_sha256", "story_count", "decision_bindings", "correction_bindings", "ordered_public_copy_sha256", "ordered_rendered_copy_sha256", "public_representation_scope", "audio_authorized", "audio_policy", "generation_authorized", "publication_authorized", "pages_authorized", "social_authorized", "scheduled_task_change_authorized", "daily_collection_authorized", "source_configuration_change_authorized", "executed", "published"],
  "properties": {
    "schema_version": {"const": "food_line_retrospective_approval_v4"},
    "approval_type": {"const": "migrated_event_retrospective_batch"},
    "approval_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "batch_id": {"type": "string", "pattern": "^food-line-[a-z0-9-]+-retrospective-[0-9]{2}$"},
    "edition_date": {"type": "string", "format": "date"},
    "edition_title": {"type": "string", "minLength": 1},
    "edition_introduction": {"type": "string", "minLength": 1},
    "retrospective_disclosure": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pages_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "recovery_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recovery_artifact_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "story_count": {"type": "integer", "minimum": 1, "maximum": 6},
    "decision_bindings": {"type": "array", "minItems": 1, "maxItems": 6},
    "correction_bindings": {"type": "array"},
    "ordered_public_copy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ordered_rendered_copy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "public_representation_scope": {"type": "array", "minItems": 9, "uniqueItems": true},
    "audio_authorized": {"const": false},
    "audio_policy": {"const": "existing_optional_audio_explicitly_not_authorized"},
    "generation_authorized": {"const": true},
    "publication_authorized": {"const": true},
    "pages_authorized": {"const": true},
    "social_authorized": {"const": false},
    "scheduled_task_change_authorized": {"const": false},
    "daily_collection_authorized": {"const": false},
    "source_configuration_change_authorized": {"const": false},
    "executed": {"const": false},
    "published": {"const": false}
  },
  "additionalProperties": false
}
