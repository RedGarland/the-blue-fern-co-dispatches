{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.thebluefernco.com/schemas/gaza-historical-catchup-publication-state-v2.schema.json",
  "title": "Gaza historical catch-up publication state v2",
  "type": "object",
  "required": ["schema_version", "catchup_id", "publication_date", "published_at", "public_path", "public_url", "approval_commit", "approval_path", "approval_sha256", "source_head", "pages_pre_publish_head", "pages_publish_commit", "candidate_ids", "event_fingerprints", "dedupe_recorded", "published"],
  "properties": {
    "schema_version": {"const": "gaza_historical_catchup_publication_state_v2"}, "catchup_id": {"type": "string"},
    "publication_date": {"type": "string", "format": "date"}, "published_at": {"type": "string", "format": "date-time"},
    "public_path": {"type": "string"}, "public_url": {"type": "string", "format": "uri"},
    "pages_pre_publish_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "pages_publish_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_ids": {"type": "array", "uniqueItems": true}, "event_fingerprints": {"type": "array", "uniqueItems": true},
    "dedupe_recorded": {"const": true}, "published": {"const": true}
  }
}
