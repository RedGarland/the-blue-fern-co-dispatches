{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.thebluefernco.com/schemas/gaza-historical-catchup-approval-v2.schema.json",
  "title": "Gaza historical catch-up approval v2",
  "type": "object",
  "required": ["schema_version", "approval_type", "catchup_id", "publication_date", "public_path", "public_url", "approved_by", "approved_at", "source_base_commit", "pages_head", "item_count", "item_order", "approved_items", "ordered_public_copy_sha256", "approval_fingerprint", "publication_authorized", "pages_authorized", "audio_authorized", "social_authorized", "scheduler_authorized", "source_configuration_authorized", "daily_collection_authorized", "existing_edition_rewrite_authorized", "executed", "published"],
  "properties": {
    "schema_version": {"const": "gaza_historical_catchup_approval_v2"},
    "approval_type": {"const": "gaza_historical_true_miss_catchup"},
    "catchup_id": {"type": "string", "pattern": "^gaza-historical-catchup-[a-z0-9][a-z0-9-]{2,80}$"},
    "publication_date": {"type": "string", "format": "date"},
    "public_path": {"type": "string", "pattern": "^gaza/catchups/gaza-historical-catchup-[a-z0-9][a-z0-9-]{2,80}/$"},
    "public_url": {"type": "string", "format": "uri"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pages_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 15},
    "item_order": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
    "approved_items": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "object"}},
    "ordered_public_copy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approval_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "publication_authorized": {"const": true}, "pages_authorized": {"const": true},
    "private_preview_authorized": {"const": true}, "private_stage_authorized": {"const": true},
    "audio_authorized": {"const": false}, "social_authorized": {"const": false},
    "scheduler_authorized": {"const": false}, "source_configuration_authorized": {"const": false},
    "daily_collection_authorized": {"const": false}, "existing_edition_rewrite_authorized": {"const": false},
    "executed": {"const": false}, "published": {"const": false}
  }
}
