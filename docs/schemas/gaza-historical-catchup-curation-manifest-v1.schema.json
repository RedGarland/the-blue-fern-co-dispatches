{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.bluefern.company/schemas/gaza-historical-catchup-curation-manifest-v1.schema.json",
  "title": "Gaza historical catch-up curation manifest v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 15,
  "items": {
    "type": "object",
    "required": ["story_id", "historical_candidate_id", "title", "summary", "category", "source_record_ids", "event_fingerprint", "attribution", "uncertainty", "historical_catchup", "approval_sha256"],
    "properties": {
      "historical_catchup": {"const": true},
      "included_in_public_summary": {"const": true}
    }
  }
}
