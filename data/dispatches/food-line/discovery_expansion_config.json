  "query_families": [
    {
      "query_family": "core_hunger",
      "geographic_scope": "national",
      "source_family": "local_news",
      "templates": [
        "\"food insecurity\"",
        "\"food bank\"",
        "\"food pantry\"",
        "\"hunger relief\"",
        "\"food bank demand\"",
        "\"food pantry demand\"",
        "\"pantry demand\"",
        "\"food bank shortage\"",
        "\"pantry shortage\"",
        "\"food bank shelves\"",
        "\"food bank inventory\"",
        "\"food bank donations down\"",
        "\"food bank serving more families\"",
        "\"mobile pantry demand\""
      ]
    },
    {
      "query_family": "public_radio",
      "geographic_scope": "national",
      "source_family": "public_radio",
      "templates": [
        "\"food bank demand\" site:npr.org",
        "\"food pantry demand\" site:npr.org",
        "\"summer hunger\" site:npr.org",
        "\"school meal gap\" site:npr.org",
