{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatches.bluefern.company/schemas/gaza-historical-catchup-approval-request-v1.schema.json",
  "title": "Gaza historical catch-up approval request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "catchup_id", "publication_date", "title", "introduction",
    "retrospective_disclosure", "approved_by", "approved_at", "source_base_commit",
    "pages_head", "review_bindings", "decision_bindings", "item_order",
    "publication_authorized", "audio_authorized", "social_authorized"
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path", "blob_sha1", "sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "pattern": "^data/agent-history/gaza/.+\\.json$"},
        "blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "gaza_historical_catchup_approval_request_v1"},
    "catchup_id": {"type": "string", "pattern": "^gaza-historical-catchup-[a-z0-9][a-z0-9-]{2,80}$"},
    "publication_date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "introduction": {"type": "string", "minLength": 1},
    "retrospective_disclosure": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pages_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_bindings": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"$ref": "#/$defs/binding"}},
    "decision_bindings": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"$ref": "#/$defs/binding"}},
    "item_order": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "publication_authorized": {"const": true},
    "audio_authorized": {"const": false},
    "social_authorized": {"const": false}
  }
}
